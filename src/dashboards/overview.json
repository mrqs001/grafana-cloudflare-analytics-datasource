{
  "uid": "cloudflare-http-overview",
  "title": "Cloudflare \u2022 HTTP overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "tags": ["cloudflare", "analytics"],
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-6h",
    "to": "now-2m"
  },
  "templating": {
    "list": [
      {
        "name": "DS_CLOUDFLARE",
        "label": "Cloudflare datasource",
        "type": "datasource",
        "query": "mrqs001-cloudflareanalytics-datasource",
        "current": {
          "text": "Cloudflare Analytics",
          "value": "cloudflare-analytics"
        }
      },
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "mrqs001-cloudflareanalytics-datasource",
          "uid": "${DS_CLOUDFLARE}"
        },
        "query": "zones()",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Edge requests \u00b7 estimated",
      "type": "stat",
      "datasource": {
        "type": "mrqs001-cloudflareanalytics-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mrqs001-cloudflareanalytics-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "zoneId": "$zone",
          "metric": "requests",
          "groupBy": [],
          "format": "total",
          "interval": "auto",
          "maxSeries": 20,
          "fill": "null",
          "filters": [
            {
              "field": "requestSource",
              "operator": "eq",
              "values": ["eyeball"]
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        }
      }
    },
